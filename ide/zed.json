// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
    "diff_view_style": "unified",
    "edit_predictions": {
        "provider": "zed",
    },
    "cli_default_open_behavior": "new_window",
    "collaboration_panel": {
        "dock": "left",
    },
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "dock": "left",
    },
    "icon_theme": "Catppuccin Mocha",
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "autosave": "off",
    "buffer_font_family": "JetBrains Mono",
    "buffer_font_features": {
        "calt": false,
    },
    "ui_font_size": 14,
    "buffer_font_size": 13.8,
    "buffer_line_height": "standard",
    "base_keymap": "VSCode",
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Zed Legacy: Andromeda", // 2 green + orange
    },
    "tabs": {
        "git_status": true,
        "file_icons": true,
    },
    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },
    "confirm_quit": true,
    "tab_size": 4,
    "terminal": {
        "font_size": 13,
        "blinking": "on",
        "copy_on_select": true,
        "toolbar": {
            "breadcrumbs": false,
        },
    },
    "languages": {
        "Rust": {
            "show_edit_predictions": false,
        },
        "JSON": {
            "tab_size": 2,
        },
        "GraphQL": {
            "tab_size": 2,
        },
        "YAML": {
            "tab_size": 2,
        },
        "SQL": {
            "formatter": "prettier",
            "tab_size": 2,
        },
        "C": {
            "format_on_save": "on",
        },
        "TypeScript": {
            "tab_size": 2,
            "format_on_save": "on",
        },
        "TSX": {
            "tab_size": 2,
            "format_on_save": "on",
        },
        "JavaScript": {
            "tab_size": 2,
            "format_on_save": "on",
        },
        "CSS": {
            "formatter": "prettier",
            "format_on_save": "on",
            "tab_size": 2,
        },
    },
    "lsp": {
        "tailwindcss-language-server": {
            "settings": {
                "classFunctions": ["cva", "cn", "clsx"],
            },
        },
    },
    "extend_comment_on_newline": false,
    "experimental.theme_overrides": {
        "syntax": {
            "comment": {
                "color": "#6fdd00",
                "font_style": "normal",
            },
            "function": {
                "font_style": "normal",
            },
        },
    },
    "telemetry": {
        "diagnostics": true,
        "metrics": true,
    },
}
